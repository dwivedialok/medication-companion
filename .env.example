GOOGLE_CLOUD_PROJECT=medication-companion-dev
# Project region for Agent Runtime, GCS, Vertex Memory Bank, BigQuery, etc.
# The Gemini API itself is always called at locations/global (pinned in
# backend/llm_models.py via GlobalGemini) — do NOT set this to "global".
GOOGLE_CLOUD_LOCATION=us-central1
# Set after deploy: projects/.../locations/us-central1/reasoningEngines/...
AGENT_RUNTIME_RESOURCE=
GCS_BUCKET=medication-companion-uploads
MEMORY_BACKEND=local
FIREBASE_PROJECT_ID=your-project-id
BIGQUERY_DATASET=medication_companion
ENVIRONMENT=local
LOG_LEVEL=INFO
DEV_PATIENT_ID=dev-patient-001

# Auth broker (Flutter apiBaseUrl points here — NOT Agent Runtime directly)
AUTH_BROKER_URL=http://localhost:8080

# Local dev: use in-process ADK Runner instead of deployed Agent Runtime
USE_LOCAL_RUNNER=true

# Agent models
PRESCRIPTION_IMAGE_READER_LLM_MODEL=gemini-3.1-flash-lite
DRUG_NAME_RESOLVER_LLM_MODEL=gemini-3.1-flash-lite
MEDICATION_SAFETY_LLM_MODEL=gemini-3.1-flash-lite
PATIENT_EDUCATION_LLM_MODEL=gemini-3.1-flash-lite
LOCALISATION_AUDIO_LLM_MODEL=gemini-3.1-flash-lite
LLM_JUDGE_MODEL=gemini-3.1-flash-lite
